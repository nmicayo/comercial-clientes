{
  "name": "radar-comercial-solar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test scripts/fonte-cnpj/*.test.ts",
    "radar:registrar-aprovados": "node --experimental-strip-types src/cli.ts radar:registrar-aprovados",
    "radar:listar-aprovados": "node --env-file=.env --experimental-strip-types src/cli.ts radar:listar-aprovados",
    "radar:enviar-aprovados": "node --env-file=.env --experimental-strip-types src/cli.ts radar:enviar-aprovados",
    "radar:aberturas": "node --env-file=.env --experimental-strip-types src/cli.ts radar:aberturas",
    "radar:auditar-brevo": "node --env-file-if-exists=.env --experimental-strip-types src/cli.ts radar:auditar-brevo",
    "radar:painel": "node --env-file-if-exists=.env --experimental-strip-types src/panel/server.ts",
    "radar:painel:build": "cd src/panel/ui && npm run build",
    "radar:painel:dev": "cd src/panel/ui && npx vite",
    "radar:importar-candidatos": "node --max-old-space-size=12288 --experimental-strip-types scripts/fonte-cnpj/importar-candidatos.ts",
    "radar:calibrar": "node --experimental-strip-types scripts/fonte-cnpj/calibrar.ts",
    "radar:pontuar": "node --max-old-space-size=12288 --experimental-strip-types scripts/fonte-cnpj/pontuar.ts",
    "radar:gerar-fila": "node --experimental-strip-types scripts/fonte-cnpj/gerar-fila.ts"
  },
  "dependencies": {
    "playwright-core": "^1.60.0"
  }
}
